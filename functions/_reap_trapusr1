emulate -L zsh

# Restart-in-original-shell handler. See spec/SPEC.md §5.1.
#
# A shell has at most one foreground job at a time, so the registry has at
# most one entry whose filename starts with $(printf '%x' $$). We find it,
# kill the old child, and re-execute via eval. The watcher we respawn will
# register the new run within THRESHOLD seconds.

local prefix
prefix=$(printf '%x' $$)
local -a entries
entries=( "${REAP[STATE_DIR]}/jobs/${prefix}-"*(N) )
(( $#entries )) || return

local entry_file=$entries[1]
local key value
local cmd_q="" cwd_q="" child_pgid=""

# Parse only the fields the trap needs. Values are printf-%q-quoted.
while IFS='=' read -r key value; do
  case $key in
    command) cmd_q=$value ;;
    cwd) cwd_q=$value ;;
    child_pgid) child_pgid=$value ;;
  esac
done < "$entry_file"

local cmd cwd
eval "cmd=$cmd_q"
eval "cwd=$cwd_q"

rm -f "$entry_file"

# Kill the old foreground process group. The trap fires while zwaitjob is
# blocked, so wait() will return as soon as we deliver the signal.
[[ -n $child_pgid ]] && kill -TERM -"$child_pgid" 2>/dev/null

[[ -n $cwd ]] && cd -- "$cwd" 2>/dev/null

# Respawn the watcher (so the new run gets registered), then re-execute.
# eval blocks the trap until the new child exits, at which point control
# returns to zsh's main loop and precmd cleans up.
_reap_preexec "$cmd"
eval -- "$cmd"
